//
// File: cfg_ntt_4u_3stream.hjson
// Description: Configuration file for Mage Radix-2 NTT testing with 4 parallel computing units
//              Stream 0 (Ping): 8 banks, 8 AGEs
//              Stream 1 (Pong): 8 banks, 8 AGEs
//              Stream 2 (Zetas): 4 banks, 4 AGEs

{

    dae_cgra : 1,
    streaming_cgra : 0,

    format_full : 1,
    format_part : 0,

    gemm_computation : 1,
    activation_computation : 0,
    has_delay_pe : 1,

    common_params: {
        kernel_len : 1,
        n_pea_rows: 4,
        n_pea_cols: 2,
        n_neigh_pe: 8,
        pattern_neigh_pe: ["UP", "LEFT", "RIGHT", "DOWN", "NW", "NE", "SE", "SW"],
    },

    dae_params: {
        n_age_tot : 20,
        n_age_per_stream : 8,
        n_streams : 3,
        n_pe_in_mem : 5,
        n_age_per_stream_ds : [8, 8, 4],
        acc_pes : [],
        pea_in_mem_placement : [
            [0, 4, 8, 12, 16],
            [1, 5, 9, 13, 17],
            [2, 6, 10, 14, 18],
            [3, 7, 11, 15, 19]
        ],
        num_words : 1024,
    },
}
