//
// File: cfg_ntt_1u_3stream.hjson
// Description: Configuration file for Mage Radix-2 NTT with 1 computing unit (2x4 PEA) and 3 streams.
//              Stream 0 (Ping):  2 banks, 2 AGEs (AGE 0, 1)
//              Stream 1 (Pong):  2 banks, 2 AGEs (AGE 2, 3)
//              Stream 2 (Zetas): 1 bank,  1 AGE  (AGE 4)

{
    dae_cgra : 1,
    streaming_cgra : 0,

    format_full : 1,
    format_part : 0,

    gemm_computation : 1,
    activation_computation : 0,
    has_delay_pe : 1,

    common_params: {
        kernel_len : 1,
        n_pea_rows: 2,
        n_pea_cols: 4,
        n_neigh_pe: 8,
        pattern_neigh_pe: ["UP", "LEFT", "RIGHT", "DOWN", "NW", "NE", "SE", "SW"],
    },

    dae_params: {
        n_age_tot : 5,
        n_age_per_stream : 2,
        n_streams : 3,
        n_pe_in_mem : 3,
        n_age_per_stream_ds : [2, 2, 1],
        acc_pes : [],
        pea_in_mem_placement : [
            [0, 2, 4],
            [1, 3, 4]
        ],
        num_words : 1024,
    },
}

