//
// File: cfg_ntt_2u_3stream.hjson
// Description: Configuration file for Mage Radix-2 NTT with 2 computing units (4x4 PEA) and 3 streams.
//              Stream 0 (Ping):  4 banks, 4 AGEs (AGE 0..3)
//              Stream 1 (Pong):  4 banks, 4 AGEs (AGE 4..7)
//              Stream 2 (Zetas): 2 banks, 2 AGEs (AGE 8..9)

{
    dae_cgra : 1,
    streaming_cgra : 0,

    format_full : 1,
    format_part : 0,

    gemm_computation : 1,
    activation_computation : 0,
    has_delay_pe : 1,

    common_params: {
        kernel_len : 1,
        n_pea_rows: 4,
        n_pea_cols: 4,
        n_neigh_pe: 8,
        pattern_neigh_pe: ["UP", "LEFT", "RIGHT", "DOWN", "NW", "NE", "SE", "SW"],
    },

    dae_params: {
        n_age_tot : 10,
        n_age_per_stream : 4,
        n_streams : 3,
        n_pe_in_mem : 3,
        n_age_per_stream_ds : [4, 4, 2],
        acc_pes : [],
        pea_in_mem_placement : [
            [0, 4, 8],
            [1, 5, 8],
            [2, 6, 9],
            [3, 7, 9]
        ],
        num_words : 1024,
    },
}

