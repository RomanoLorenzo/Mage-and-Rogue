{
  name: "pulp_platform_axi",
  target_dir: "pulp_platform_axi",

  upstream: {
    url: "https://github.com/pulp-platform/axi.git",
    rev: "v0.39.8",
  },

  mapping: [
    {from: 'include', to: 'include' },
    {from: 'src/axi_pkg.sv', to: 'src/axi_pkg.sv' },
    {from: 'src/axi_to_detailed_mem.sv', to: 'src/axi_to_detailed_mem.sv' },
    {from: 'src/axi_demux_simple.sv', to: 'src/axi_demux_simple.sv' },
  ]
}

