    {from: 'src/stream_join.sv', to: 'src/stream_join.sv' },
    {from: 'src/stream_fork_dynamic.sv', to: 'src/stream_fork_dynamic.sv' },
    {from: 'src/spill_register_flushable.sv', to: 'src/spill_register_flushable.sv' },
    {from: 'src/spill_register.sv', to: 'src/spill_register.sv' },
    {from: 'src/lzc.sv', to: 'src/lzc.sv' },
    {from: 'src/rr_arb_tree.sv', to: 'src/rr_arb_tree.sv' },
    {from: 'src/stream_arbiter_flushable.sv', to: 'src/stream_arbiter_flushable.sv' },
