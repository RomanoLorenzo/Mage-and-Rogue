{
  name: "pulp_platform_register_interface",
  target_dir: "pulp_platform_register_interface",

  upstream: {
    url: "https://github.com/pulp-platform/register_interface.git",
    rev: "v0.4.7",
  },

  mapping: [
    {from: 'include', to: 'include' },
    {from: 'src/reg_intf.sv', to: 'src/mage_reg_intf.sv' },
    {from: 'src/periph_to_reg.sv', to: 'src/mage_periph_to_reg.sv' },
    {from: 'src/reg_mux.sv', to: 'src/mage_reg_mux.sv' },
    {from: 'src/reg_demux.sv', to: 'src/mage_reg_demux.sv' },
    {from: 'src/axi_to_reg_v2.sv', to: 'src/mage_axi_to_reg_v2.sv' },

    {from: 'LICENSE', to: 'LICENSE' },
  ]

}

